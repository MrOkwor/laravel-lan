{
    "name": "mrokwor/laravel-lan",
    "description": "Developer-focused local networking tool for Laravel applications",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "laravel",
        "lan",
        "local-network",
        "qr-code",
        "mobile-testing",
        "dx"
    ],
    "authors": [
        {
            "name": "mrokwor"
        }
    ],
    "require": {
        "php": "^8.2 || ^8.3 || ^8.4",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0",
        "illuminate/console": "^10.0 || ^11.0 || ^12.0",
        "symfony/process": "^6.0 || ^7.0",
        "chillerlan/php-qrcode": "^5.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0",
        "phpunit/phpunit": "^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Mrokwor\\LaravelLan\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mrokwor\\LaravelLan\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mrokwor\\LaravelLan\\LaravelLanServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
